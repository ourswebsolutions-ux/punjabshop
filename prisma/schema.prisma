// PunjabShoes database schema (MySQL 8 / MariaDB 10.6+).
// Field names stay snake_case so they match the column names used across the app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  super_admin
  manager
  staff
}

enum ActiveStatus {
  active
  inactive
}

enum AdminStatus {
  active
  disabled
}

enum CustomerStatus {
  active
  blocked
}

enum PaymentMethod {
  cod
  jazzcash
  easypaisa
  bank_transfer
}

enum OrderPaymentStatus {
  unpaid
  awaiting_payment
  pending_verification
  paid
  failed
  refunded
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned
}

enum PaymentRecordStatus {
  initiated
  pending_verification
  paid
  failed
  refunded
}

enum CouponType {
  percent
  fixed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

enum BannerPlacement {
  hero
  promo
}

enum BannerTheme {
  light
  dark
}

model Admin {
  id            Int         @id @default(autoincrement()) @db.UnsignedInt
  name          String      @db.VarChar(120)
  email         String      @unique @db.VarChar(190)
  password_hash String      @db.VarChar(255)
  role          AdminRole   @default(staff)
  status        AdminStatus @default(active)
  last_login_at DateTime?   @db.DateTime(0)
  created_at    DateTime    @default(now()) @db.DateTime(0)
  updated_at    DateTime    @default(now()) @updatedAt @db.DateTime(0)

  @@map("admins")
}

model Customer {
  id            Int            @id @default(autoincrement()) @db.UnsignedInt
  name          String         @db.VarChar(120)
  email         String         @unique @db.VarChar(190)
  phone         String?        @db.VarChar(20)
  password_hash String         @db.VarChar(255)
  status        CustomerStatus @default(active)
  created_at    DateTime       @default(now()) @db.DateTime(0)
  updated_at    DateTime       @default(now()) @updatedAt @db.DateTime(0)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
  carts     Cart[]

  @@map("customers")
}

model Address {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  customer_id Int      @db.UnsignedInt
  name        String   @db.VarChar(120)
  phone       String   @db.VarChar(20)
  address     String   @db.VarChar(500)
  city        String   @db.VarChar(80)
  province    String   @db.VarChar(80)
  postal_code String?  @db.VarChar(10)
  is_default  Boolean  @default(false)
  created_at  DateTime @default(now()) @db.DateTime(0)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)

  @@index([customer_id])
  @@map("addresses")
}

model Category {
  id              Int          @id @default(autoincrement()) @db.UnsignedInt
  parent_id       Int?         @db.UnsignedInt
  name            String       @db.VarChar(120)
  menu_label      String?      @db.VarChar(60)
  slug            String       @unique @db.VarChar(140)
  description     String?      @db.Text
  image           String?      @db.VarChar(255)
  status          ActiveStatus @default(active)
  show_in_menu    Boolean      @default(false)
  show_on_home    Boolean      @default(false)
  sort_order      Int          @default(0)
  seo_title       String?      @db.VarChar(190)
  seo_description String?      @db.VarChar(300)
  created_at      DateTime     @default(now()) @db.DateTime(0)
  updated_at      DateTime     @default(now()) @updatedAt @db.DateTime(0)

  parent   Category?         @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([parent_id])
  @@index([sort_order])
  @@map("categories")
}

model Product {
  id                  Int          @id @default(autoincrement()) @db.UnsignedInt
  name                String       @db.VarChar(190)
  slug                String       @unique @db.VarChar(210)
  sku                 String       @unique @db.VarChar(64)
  short_description   String?      @db.VarChar(500)
  description         String?      @db.Text
  price               Decimal      @db.Decimal(10, 2)
  sale_price          Decimal?     @db.Decimal(10, 2)
  status              ActiveStatus @default(active)
  is_featured         Boolean      @default(false)
  is_best_seller      Boolean      @default(false)
  is_new_arrival      Boolean      @default(false)
  low_stock_threshold Int          @default(5)
  sold_count          Int          @default(0) @db.UnsignedInt
  view_count          Int          @default(0) @db.UnsignedInt
  rating_avg          Decimal      @default(0) @db.Decimal(3, 2)
  rating_count        Int          @default(0) @db.UnsignedInt
  seo_title           String?      @db.VarChar(190)
  seo_description     String?      @db.VarChar(300)
  created_at          DateTime     @default(now()) @db.DateTime(0)
  updated_at          DateTime     @default(now()) @updatedAt @db.DateTime(0)

  categories ProductCategory[]
  images     ProductImage[]
  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]
  wishlist   Wishlist[]
  cartItems  CartItem[]

  @@index([status])
  @@index([is_featured, is_best_seller, is_new_arrival])
  @@map("products")
}

model ProductCategory {
  product_id  Int @db.UnsignedInt
  category_id Int @db.UnsignedInt

  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([product_id, category_id])
  @@index([category_id])
  @@map("product_categories")
}

model ProductImage {
  id         Int     @id @default(autoincrement()) @db.UnsignedInt
  product_id Int     @db.UnsignedInt
  url        String  @db.VarChar(255)
  alt        String? @db.VarChar(190)
  sort_order Int     @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id, sort_order])
  @@map("product_images")
}

/// Every product has at least one variant. A product without sizes/colours has a
/// single variant where size and color are NULL.
model ProductVariant {
  id               Int          @id @default(autoincrement()) @db.UnsignedInt
  product_id       Int          @db.UnsignedInt
  sku              String?      @db.VarChar(80)
  size             String?      @db.VarChar(30)
  color            String?      @db.VarChar(40)
  color_hex        String?      @db.VarChar(9)
  price_adjustment Decimal      @default(0) @db.Decimal(10, 2)
  stock            Int          @default(0)
  status           ActiveStatus @default(active)

  product    Product     @relation(fields: [product_id], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([product_id])
  @@index([size])
  @@index([color])
  @@map("product_variants")
}

model Coupon {
  id                 Int          @id @default(autoincrement()) @db.UnsignedInt
  code               String       @unique @db.VarChar(40)
  description        String?      @db.VarChar(255)
  type               CouponType   @default(percent)
  value              Decimal      @db.Decimal(10, 2)
  min_order          Decimal      @default(0) @db.Decimal(10, 2)
  max_discount       Decimal?     @db.Decimal(10, 2)
  usage_limit        Int?         @db.UnsignedInt
  per_customer_limit Int?         @db.UnsignedInt
  used_count         Int          @default(0) @db.UnsignedInt
  starts_at          DateTime?    @db.DateTime(0)
  expires_at         DateTime?    @db.DateTime(0)
  status             ActiveStatus @default(active)
  created_at         DateTime     @default(now()) @db.DateTime(0)

  redemptions CouponRedemption[]

  @@map("coupons")
}

model Order {
  id              Int                @id @default(autoincrement()) @db.UnsignedInt
  order_number    String             @unique @db.VarChar(20)
  access_token    String             @db.Char(32)
  customer_id     Int?               @db.UnsignedInt
  name            String             @db.VarChar(120)
  phone           String             @db.VarChar(20)
  email           String?            @db.VarChar(190)
  address         String             @db.VarChar(500)
  city            String             @db.VarChar(80)
  province        String             @db.VarChar(80)
  postal_code     String?            @db.VarChar(10)
  notes           String?            @db.VarChar(1000)
  subtotal        Decimal            @db.Decimal(10, 2)
  discount        Decimal            @default(0) @db.Decimal(10, 2)
  shipping_fee    Decimal            @default(0) @db.Decimal(10, 2)
  payment_fee     Decimal            @default(0) @db.Decimal(10, 2)
  total           Decimal            @db.Decimal(10, 2)
  coupon_code     String?            @db.VarChar(40)
  payment_method  PaymentMethod
  payment_status  OrderPaymentStatus @default(unpaid)
  status          OrderStatus        @default(pending)
  courier         String?            @db.VarChar(80)
  tracking_number String?            @db.VarChar(80)
  admin_notes     String?            @db.VarChar(1000)
  stock_restored  Boolean            @default(false)
  created_at      DateTime           @default(now()) @db.DateTime(0)
  updated_at      DateTime           @default(now()) @updatedAt @db.DateTime(0)

  customer    Customer?            @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  items       OrderItem[]
  history     OrderStatusHistory[]
  payments    Payment[]
  redemptions CouponRedemption[]

  @@index([status])
  @@index([created_at])
  @@index([phone])
  @@index([customer_id])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement()) @db.UnsignedInt
  order_id     Int     @db.UnsignedInt
  product_id   Int?    @db.UnsignedInt
  variant_id   Int?    @db.UnsignedInt
  product_name String  @db.VarChar(190)
  sku          String? @db.VarChar(80)
  size         String? @db.VarChar(30)
  color        String? @db.VarChar(40)
  image        String? @db.VarChar(255)
  unit_price   Decimal @db.Decimal(10, 2)
  quantity     Int     @db.UnsignedInt
  line_total   Decimal @db.Decimal(10, 2)

  order   Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [product_id], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([product_id])
  @@index([variant_id])
  @@map("order_items")
}

model OrderStatusHistory {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  order_id   Int      @db.UnsignedInt
  status     String   @db.VarChar(40)
  note       String?  @db.VarChar(500)
  created_by String?  @db.VarChar(120)
  created_at DateTime @default(now()) @db.DateTime(0)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_status_history")
}

model Payment {
  id               Int                 @id @default(autoincrement()) @db.UnsignedInt
  order_id         Int                 @db.UnsignedInt
  method           PaymentMethod
  amount           Decimal             @db.Decimal(10, 2)
  status           PaymentRecordStatus @default(initiated)
  gateway_ref      String?             @db.VarChar(120)
  transaction_ref  String?             @db.VarChar(120)
  payer_account    String?             @db.VarChar(80)
  proof_image      String?             @db.VarChar(255)
  gateway_response Json?
  verified_by      Int?                @db.UnsignedInt
  verified_at      DateTime?           @db.DateTime(0)
  created_at       DateTime            @default(now()) @db.DateTime(0)
  updated_at       DateTime            @default(now()) @updatedAt @db.DateTime(0)

  order Order @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([gateway_ref])
  @@map("payments")
}

model CouponRedemption {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  coupon_id   Int      @db.UnsignedInt
  order_id    Int      @db.UnsignedInt
  customer_id Int?     @db.UnsignedInt
  phone       String?  @db.VarChar(20)
  created_at  DateTime @default(now()) @db.DateTime(0)

  coupon Coupon @relation(fields: [coupon_id], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([coupon_id])
  @@index([order_id])
  @@map("coupon_redemptions")
}

model Review {
  id                   Int          @id @default(autoincrement()) @db.UnsignedInt
  product_id           Int          @db.UnsignedInt
  customer_id          Int?         @db.UnsignedInt
  name                 String       @db.VarChar(120)
  rating               Int          @db.UnsignedTinyInt
  title                String?      @db.VarChar(190)
  comment              String       @db.Text
  is_verified_purchase Boolean      @default(false)
  status               ReviewStatus @default(pending)
  created_at           DateTime     @default(now()) @db.DateTime(0)

  product  Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([product_id, status])
  @@index([customer_id])
  @@map("reviews")
}

model Wishlist {
  customer_id Int      @db.UnsignedInt
  product_id  Int      @db.UnsignedInt
  created_at  DateTime @default(now()) @db.DateTime(0)

  customer Customer @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@id([customer_id, product_id])
  @@index([product_id])
  @@map("wishlist")
}

model Cart {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  token       String   @unique @db.Char(32)
  customer_id Int?     @db.UnsignedInt
  coupon_code String?  @db.VarChar(40)
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  customer Customer?  @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  items    CartItem[]

  @@index([customer_id])
  @@map("carts")
}

model CartItem {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  cart_id    Int      @db.UnsignedInt
  product_id Int      @db.UnsignedInt
  variant_id Int      @db.UnsignedInt
  quantity   Int      @default(1) @db.UnsignedInt
  created_at DateTime @default(now()) @db.DateTime(0)

  cart    Cart           @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@unique([cart_id, variant_id])
  @@index([product_id])
  @@index([variant_id])
  @@map("cart_items")
}

model Banner {
  id              Int             @id @default(autoincrement()) @db.UnsignedInt
  placement       BannerPlacement
  badge           String?         @db.VarChar(60)
  title           String          @db.VarChar(120)
  highlight       String?         @db.VarChar(120)
  subtitle        String?         @db.VarChar(190)
  description     String?         @db.VarChar(300)
  offer_text      String?         @db.VarChar(60)
  offer_highlight String?         @db.VarChar(60)
  button_text     String?         @db.VarChar(60)
  button_link     String?         @db.VarChar(255)
  image           String          @db.VarChar(255)
  theme           BannerTheme     @default(light)
  sort_order      Int             @default(0)
  status          ActiveStatus    @default(active)
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @updatedAt @db.DateTime(0)

  @@map("banners")
}

model Testimonial {
  id         Int          @id @default(autoincrement()) @db.UnsignedInt
  name       String       @db.VarChar(120)
  quote      String       @db.VarChar(400)
  avatar     String?      @db.VarChar(255)
  rating     Int          @default(5) @db.UnsignedTinyInt
  sort_order Int          @default(0)
  status     ActiveStatus @default(active)
  created_at DateTime     @default(now()) @db.DateTime(0)

  @@map("testimonials")
}

model Setting {
  key        String   @id @db.VarChar(80)
  value      Json
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  @@map("settings")
}

model NewsletterSubscriber {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  email      String   @unique @db.VarChar(190)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@map("newsletter_subscribers")
}

model ContactMessage {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  name       String   @db.VarChar(120)
  email      String?  @db.VarChar(190)
  phone      String?  @db.VarChar(20)
  subject    String?  @db.VarChar(190)
  message    String   @db.Text
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.DateTime(0)

  @@map("contact_messages")
}
